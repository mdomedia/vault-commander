{
  "name": "vault-commander",
  "version": "0.9.0",
  "description": "Local-first, Jira-grade project board for your Obsidian vault. Plain Markdown in, beautiful board out — nothing leaves your machine.",
  "homepage": "https://vaultcommander.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mdomedia/vault-commander.git"
  },
