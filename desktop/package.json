{
  "name": "vault-commander-desktop",
  "version": "0.9.2",
  "private": true,
  "description": "Vault Commander desktop app — an Electron shell that runs the local server and shows it in a real window.",
  "author": "MdO Media LLC",
  "license": "AGPL-3.0-or-later",
  "main": "main.js",
  "scripts": {
    "copy-app": "node scripts/copy-app.js",
    "start": "npm run copy-app && electron .",
    "dist": "npm run copy-app && electron-builder",
    "dist:mac": "npm run copy-app && electron-builder --mac",
    "dist:win": "npm run copy-app && electron-builder --win",
    "dist:linux": "npm run copy-app && electron-builder --linux"
  },
  "dependencies": {
    "chokidar": "^3.6.0",
    "express": "^4.21.0",
    "glob": "^10.3.0",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "studio.mdo.vaultcommander",
    "productName": "Vault Commander",
    "copyright": "Copyright 2026 MdO Media LLC",
    "asar": false,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "server.js",
      "public/**/*"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": true
    },
    "dmg": {
      "title": "Vault Commander ${version}"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office"
    }
  }
}
